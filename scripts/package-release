#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
set -euo pipefail

if [[ $# != 2 ]] || [[ ! $1 =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "Usage: RELEASE_SIGNING_FINGERPRINT=<GPG fingerprint> $0 <version without v> <new output directory>" >&2
  exit 2
fi

version=$1
: "${RELEASE_SIGNING_FINGERPRINT:?Set the fingerprint for the release signing key}"
if [[ ! $RELEASE_SIGNING_FINGERPRINT =~ ^[[:xdigit:]]{40}$ ]]; then
  echo "Use the full fingerprint of the RSA OpenPGP key." >&2
  exit 2
fi

source_root=$(cd -- "$(dirname -- "$0")/.." && pwd)
revision=$(git -C "$source_root" rev-parse HEAD)
# Registries enroll the primary key. Pin the actual RSA signing key as well,
# since GPG otherwise selects a signing subkey automatically.
primary=${RELEASE_SIGNING_FINGERPRINT^^}
signer=$(gpg --batch --with-colons --list-secret-keys "$primary" | awk -F: -v primary="$primary" '
  $1 == "sec" || $1 == "ssb" {
    rsa = ($4 == 1 || $4 == 3)
    primary_record = ($1 == "sec")
    usable = rsa && $2 !~ /^[redi]$/ && $12 ~ /s/ && $12 !~ /D/ && $15 != "#"
  }
  $1 == "fpr" {
    if (primary_record && ($10 != primary || !rsa)) exit 1
    if (usable) signer = $10
  }
  END { if (!signer) exit 1; print signer }
') || { echo "Use an RSA primary key with a usable RSA signing key." >&2; exit 2; }
mkdir -- "$2"
output=$(cd -- "$2" && pwd)
build=$(mktemp -d "$output/.build.XXXXXX")
trap 'rm -rf -- "$build"' EXIT

# Build only the committed files, even when local development files are present.
git -C "$source_root" archive "$revision" | tar -xf - -C "$build"
cd -- "$build"
name=terraform-provider-irisbeat
prefix="${name}_${version}"
manifest="${prefix}_manifest.json"
sums="${prefix}_SHA256SUMS"
cp -- terraform-registry-manifest.json "$manifest"

for os in linux darwin windows; do
  for arch in amd64 arm64; do
    binary="${name}_v${version}"
    if [[ $os == windows ]]; then
      binary+=".exe"
    fi
    CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -mod=readonly -trimpath -buildvcs=false \
      -ldflags="-X main.version=$version" -o "$binary" .
    python3 -m zipfile -c "${prefix}_${os}_${arch}.zip" "$binary" LICENSE NOTICE
    rm -- "$binary"
  done
done

sha256sum -- "${prefix}"_*.zip "$manifest" > "$sums"
gpg --no-armor --local-user "$signer!" --output "$sums.sig" --detach-sign "$sums"
gpg --batch --status-fd=1 --verify "$sums.sig" "$sums" |
  awk -v signer="$signer" -v primary="$primary" '
    $2 == "VALIDSIG" && $3 == signer && ($9 == 1 || $9 == 3) && $12 == primary { valid = 1 }
    END { exit !valid }
  '
sha256sum --check --strict "$sums"
mv -- "${prefix}"_*.zip "$manifest" "$sums" "$sums.sig" "$output/"
printf 'Packaged %s from %s in %s\n' "$version" "$revision" "$output"
